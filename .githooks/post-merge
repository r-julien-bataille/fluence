#!/bin/sh
# Ensure fast-forward or merge commits on main also bump package.json version before push.

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$BRANCH" = "main" ]; then
  NEW_VERSION=$(node scripts/bump-version.mjs --if-needed)
  if [ -n "$NEW_VERSION" ]; then
    git add package.json
    git commit --no-verify -m "chore(release): bump version to v$NEW_VERSION"
    echo "[fluence] Bumped app version to v$NEW_VERSION after merge"
  fi
fi
