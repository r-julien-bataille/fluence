#!/bin/sh
# Upgrade SemVer bump level (e.g. patch -> minor/major) based on the commit message
# if Conventional Commits (feat:, !:, BREAKING CHANGE) require a higher version bump.

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$BRANCH" = "main" ]; then
  NEW_VERSION=$(node scripts/bump-version.mjs --if-needed)
  if [ -n "$NEW_VERSION" ]; then
    git add package.json
    git commit --amend --no-edit --no-verify
    echo "[fluence] Upgraded app version to v$NEW_VERSION in package.json (based on commit message)"
  fi
fi
